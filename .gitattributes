# Git 行尾符统一为 LF 的配置模板
# 提交后将强制仓库内所有文本文件以 LF 存储
# 默认所有文本文件自动处理，统一为 LF
* text=auto eol=lf

# 明确指定常见文本类型为 LF
*.md         text eol=lf
*.txt        text eol=lf
*.json       text eol=lf
*.yml        text eol=lf
*.yaml       text eol=lf
*.xml        text eol=lf
*.html       text eol=lf
*.css        text eol=lf
*.js         text eol=lf
*.ts         text eol=lf
*.jsx        text eol=lf
*.tsx        text eol=lf
*.vue        text eol=lf
*.py         text eol=lf
*.java       text eol=lf
*.c          text eol=lf
*.cpp        text eol=lf
*.h          text eol=lf
*.cs         text eol=lf
*.go         text eol=lf
*.rs         text eol=lf
*.rb         text eol=lf
*.php        text eol=lf
*.sh         text eol=lf
*.sql        text eol=lf
*.toml       text eol=lf
*.ini        text eol=lf
*.conf       text eol=lf
*.gitignore  text eol=lf
*.gitattributes text eol=lf

# Windows 专用文件保持 CRLF（按需保留）
*.bat        text eol=crlf
*.cmd        text eol=crlf
*.ps1        text eol=crlf

# 二进制文件，不做行尾转换
*.png        binary
*.jpg        binary
*.jpeg       binary
*.webp       binary
*.gif        binary
*.ico        binary
*.pdf        binary
*.zip        binary
*.gz         binary
*.tar        binary
*.7z         binary
*.exe        binary
*.dll        binary
*.so         binary
*.dylib      binary
*.class      binary
*.jar        binary
*.war        binary
*.db         binary
*.czdb       binary
*.sqlite     binary
*.ttf        binary
*.woff       binary
*.woff2      binary
