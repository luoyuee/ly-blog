// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider     = "prisma-client"
  output       = "../prisma/generated"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

// 系统配置表：按名称存储客户端、服务端及功能模块的 JSON 配置。
model Config {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  created_by Int?
  updated_at DateTime?
  updated_by Int?
  name       String    @unique @db.VarChar(255)
  data       Json

  @@map("config")
}

// 一言分类表：维护一言内容的分类名称与说明。
model HitokotoType {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  name        String    @unique @db.VarChar(255)
  description String?   @db.VarChar(512)

  hitokotos Hitokoto[]

  @@map("hitokoto_type")
}

// 一言内容表：存储短句正文、来源、作者及所属分类。
model Hitokoto {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  created_by Int?
  updated_at DateTime?
  updated_by Int?
  type       Int?
  source     String?   @db.VarChar(255)
  author     String?   @db.VarChar(255)
  content    String    @db.Text
  length     Int

  HitokotoType HitokotoType? @relation(fields: [type], references: [id])

  @@index([length, type])
  @@index([type])
  @@map("hitokoto")
}

// 文章分类表：维护文章分类及其层级、图标和状态。
model ArticleCategory {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  parent_id   Int?
  icon        String?
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(1024)
  status      Int       @default(1) // 0:已删除，1:正常状态

  articles Article[]

  @@map("article_category")
}

// 文章表：存储由笔记发布的文章内容、展示配置及统计数据。
model Article {
  id                     Int       @id @default(autoincrement())
  created_at             DateTime? @default(now())
  created_by             Int?
  updated_at             DateTime?
  updated_by             Int?
  note_id                Int
  note_version           Int
  extension              String    @db.VarChar(64)
  published_at           DateTime
  category_id            Int?
  title                  String    @db.VarChar(1024)
  abstract               String    @db.Text
  content                String    @db.Text
  content_updated_at     DateTime? @default(now())
  chars                  Int
  tags                   Json?
  author                 String    @db.VarChar(255)
  cover                  Json?
  pin_priority           Int? // 优先级（默认不置顶）
  password               String?   @db.VarChar(255)
  allow_comments         Boolean   @default(true)
  allow_rewards          Boolean   @default(false)
  custom_url             String?   @unique
  custom_url_access_only Boolean   @default(false)
  toc                    Json?
  view_count             Int       @default(0)
  like_count             Int       @default(0)
  comment_count          Int       @default(0)
  status                 Int       @default(1) // 0:已删除，1:正常状态, 2:锁定状态（不展示）

  ArticleCategory ArticleCategory? @relation(fields: [category_id], references: [id])
  Note            Note?            @relation(fields: [note_id], references: [id])

  articleComments ArticleComment[]

  @@index([category_id])
  @@index([note_id])
  @@index([status, custom_url_access_only])
  @@index([status, category_id])
  @@map("article")
}

// 文章评论表：存储文章评论、回复关系及访客环境信息。
model ArticleComment {
  id             Int       @id @default(autoincrement())
  created_at     DateTime? @default(now())
  created_by     Int?
  updated_at     DateTime?
  updated_by     Int?
  article_id     Int
  email          String    @db.VarChar(255)
  website        String?   @db.VarChar(512)
  avatar         String?   @db.VarChar(512)
  nickname       String    @db.VarChar(255)
  content        String    @db.Text
  parent_id      Int?
  reply_id       Int?
  reply_nickname String?   @db.VarChar(255)
  ip             String?   @db.VarChar(64)
  location       String?   @db.VarChar(512)
  platform       String?   @db.VarChar(255)
  browser        String?   @db.VarChar(255)
  role           Int       @default(2) // 0:超级管理员 1:普通用户 2:游客
  status         Int       @default(1) // 0:已删除，1:正常状态

  Article Article? @relation(fields: [article_id], references: [id])

  @@index([article_id, status])
  @@index([parent_id])
  @@index([reply_id])
  @@map("article_comment")
}

// 笔记目录表：维护笔记目录层级、状态及锁定信息。
model NoteFolder {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  created_by Int?
  updated_at DateTime?
  updated_by Int?
  parent_id  Int?
  name       String    @db.VarChar(255)
  status     Int       @default(1) // 0:已删除，1:正常状态
  locked     Boolean   @default(false) // 锁定状态（默认未锁定）
  locked_at  DateTime? // 锁定时间
  locked_by  Int? // 锁定操作者ID

  notes Note[]

  @@map("note_folder")
}

// 笔记表：存储可编辑的笔记正文、来源信息及当前版本。
model Note {
  id                 Int       @id @default(autoincrement())
  created_at         DateTime? @default(now())
  created_by         Int?
  updated_at         DateTime?
  updated_by         Int?
  folder_id          Int?
  name               String    @db.VarChar(512)
  extension          String    @db.VarChar(64)
  version            Int       @default(1)
  content            String    @db.Text
  content_updated_at DateTime? @default(now())
  chars              Int
  source_type        String?   @db.VarChar(64) // 外部来源类型，如 siyuan、obsidian、typora
  source_id          String?   @db.VarChar(255) // 外部来源内的唯一文章标识，用于重复导入时执行更新
  source_url         String?   @db.VarChar(512) // 外部来源文章链接或协议地址
  source_updated_at  DateTime? // 外部来源文章最后更新时间
  imported_at        DateTime? // 最近一次从外部内容包导入的时间
  metadata           Json? // 通用元数据存储
  status             Int       @default(1) // 0:已删除，1:正常状态
  locked             Boolean   @default(false) // 文件锁定状态
  locked_at          DateTime? // 锁定时间
  locked_by          Int? // 锁定操作者ID

  NoteFolder NoteFolder? @relation(fields: [folder_id], references: [id])

  versions NoteVersion[]
  Article  Article[]

  @@unique([source_type, source_id]) // 保证同一外部来源文章只对应一篇笔记
  @@index([folder_id, status])
  @@map("note")
}

// 笔记版本表：保存笔记各历史版本的内容快照。
model NoteVersion {
  id                 Int       @id @default(autoincrement())
  created_at         DateTime? @default(now())
  created_by         Int?
  updated_at         DateTime?
  updated_by         Int?
  note_id            Int
  folder_id          Int?
  name               String    @db.VarChar(512)
  extension          String    @db.VarChar(64)
  version            Int
  content            String    @db.Text
  content_updated_at DateTime? @default(now())
  chars              Int
  metadata           Json? // 通用元数据存储
  status             Int       @default(1) // 0:已删除，1:正常状态

  Note Note? @relation(fields: [note_id], references: [id])

  @@unique([note_id, version])
  @@index([note_id, status])
  @@map("note_version")
}

// 物理资源表：按内容哈希管理去重后的文件及图片实体。
model Asset {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  created_by Int?
  updated_at DateTime?
  updated_by Int?
  hash       String    @unique @db.VarChar(128) // 物理文件内容哈希，同内容文件只保存一份
  ext        String    @db.VarChar(64) // 物理文件扩展名，用于按配置拼接存储路径和访问地址
  mime_type  String?   @db.VarChar(128) // 文件 MIME 类型，用于响应 Content-Type
  size       Int // 物理文件字节大小
  preview    String?   @db.VarChar(128) // 图片预览图哈希，非图片资源为空
  width      Int? // 图片宽度，非图片资源为空
  height     Int? // 图片高度，非图片资源为空
  metadata   Json? // 物理资源扩展信息，如导入来源路径、解析结果等
  status     Int       @default(1) // 0:已删除，1:正常状态

  files  File[] // 引用该物理资源的附件记录
  images Image[] // 引用该物理资源的图片记录

  @@map("asset")
}

// 附件目录表：维护附件分组及目录容量统计。
model FileFolder {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  name        String    @db.VarChar(255)
  icon        String?   @db.VarChar(512)
  description String?   @db.VarChar(1024)
  cover       String?   @db.VarChar(512)
  count       Int       @default(0)
  size        Int       @default(0)
  status      Int       @default(1) // 0:已删除，1:正常状态

  files File[]

  @@map("file_folder")
}

// 附件表：记录附件业务信息并关联所属目录和物理资源。
model File {
  id             Int       @id @default(autoincrement())
  created_at     DateTime? @default(now())
  created_by     Int?
  updated_at     DateTime?
  updated_by     Int?
  folder_id      Int // 所属附件目录ID，必填以保证目录内文件名唯一约束有效
  asset_id       Int // 关联的物理资源ID
  original_name  String    @db.VarChar(512) // 上传时的原始文件名
  filename       String    @db.VarChar(512) // 目录内最终展示文件名，重名时由业务层追加后缀
  tags           Json? // 附件业务标签，用于后台管理和搜索
  metadata       Json? // 通用元数据存储
  download_count Int       @default(0)
  password       String?   @db.VarChar(255)
  status         Int       @default(1) // 0:已删除，1:正常状态

  FileFolder FileFolder @relation(fields: [folder_id], references: [id], onDelete: Restrict) // 有附件引用时禁止删除目录
  Asset      Asset      @relation(fields: [asset_id], references: [id], onDelete: Restrict) // 有附件引用时禁止删除物理资源

  @@unique([folder_id, filename]) // 同一目录下展示文件名唯一
  @@index([folder_id, status]) // 按目录查询正常附件列表
  @@index([asset_id]) // 按物理资源反查附件记录
  @@map("file")
}

// 图片目录表：维护图片分组、封面及容量统计。
model ImageFolder {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(1024)
  cover       String?   @db.VarChar(512)
  count       Int       @default(0)
  size        Int       @default(0)
  is_system   Boolean   @default(false)
  status      Int       @default(1) // 0:已删除，1:正常状态

  images Image[]

  @@map("image_folder")
}

// 图片表：记录图片业务信息并关联所属目录和物理资源。
model Image {
  id            Int       @id @default(autoincrement())
  created_at    DateTime? @default(now())
  created_by    Int?
  updated_at    DateTime?
  updated_by    Int?
  folder_id     Int // 所属图片目录ID，必填以保证目录内文件名唯一约束有效
  asset_id      Int // 关联的物理资源ID
  original_name String    @db.VarChar(512) // 上传时的原始图片文件名
  filename      String    @db.VarChar(512) // 图片库中的最终展示文件名，重名时由业务层追加后缀
  tags          Json? // 图片业务标签，用于图片管理和搜索
  status        Int       @default(1) // 0:已删除，1:正常状态

  ImageFolder ImageFolder @relation(fields: [folder_id], references: [id], onDelete: Restrict) // 有图片引用时禁止删除目录
  Asset       Asset       @relation(fields: [asset_id], references: [id], onDelete: Restrict) // 有图片引用时禁止删除物理资源

  @@unique([folder_id, filename]) // 同一目录下展示文件名唯一
  @@index([folder_id, status]) // 按目录查询正常图片列表
  @@index([asset_id]) // 按物理资源反查图片记录
  @@map("image")
}

// 用户表：存储账号资料、角色、登录信息及账号状态。
model User {
  id                  Int       @id @default(autoincrement())
  created_at          DateTime? @default(now())
  created_by          Int?
  updated_at          DateTime?
  updated_by          Int?
  nickname            String    @db.VarChar(255)
  username            String    @unique @db.VarChar(255)
  password            String    @db.VarChar(255)
  avatar              String?   @db.VarChar(512)
  email               String    @unique @db.VarChar(255)
  role                Int       @default(1) // 0:超级管理员 1:普通用户 2:游客
  last_login_at       DateTime?
  last_login_ip       String?   @db.VarChar(64)
  last_login_location String?   @db.VarChar(255)
  status              Int       @default(1) // 0:已删除，1:正常状态

  @@map("user")
}

// API 密钥表：管理外部调用凭证、权限范围及使用记录。
model ApiKey {
  id           Int       @id @default(autoincrement())
  created_at   DateTime? @default(now())
  created_by   Int?
  updated_at   DateTime?
  updated_by   Int?
  name         String    @db.VarChar(255) // API Key 名称，用于后台识别调用方
  key_hash     String    @unique @db.VarChar(128) // Secret API Key 哈希值，明文只在创建时返回一次
  scopes       Json // 权限范围，如 hitokoto:import、note:import
  expires_at   DateTime? // 过期时间，空表示长期有效
  last_used_at DateTime? // 最近一次使用时间
  last_used_ip String?   @db.VarChar(64) // 最近一次使用 IP
  use_count    Int       @default(0) // 使用次数
  status       Int       @default(1) // 0:已禁用，1:正常状态

  @@index([status])
  @@index([expires_at])
  @@map("api_key")
}

// 留言板表：存储站点留言、回复关系及访客环境信息。
model MessageBoard {
  id             Int       @id @default(autoincrement())
  created_at     DateTime? @default(now())
  created_by     Int?
  updated_at     DateTime?
  updated_by     Int?
  email          String    @db.VarChar(255)
  website        String?   @db.VarChar(512)
  avatar         String?   @db.VarChar(512)
  nickname       String    @db.VarChar(255)
  content        String    @db.Text
  parent_id      Int?
  reply_id       Int?
  reply_nickname String?   @db.VarChar(255)
  ip             String?   @db.VarChar(64)
  location       String?   @db.VarChar(512)
  platform       String?   @db.VarChar(255)
  browser        String?   @db.VarChar(255)
  role           Int       @default(2) // 0:超级管理员 1:普通用户 2:游客
  status         Int       @default(1) // 0:已删除，1:正常状态

  @@map("message_board")
}

// 闪念表：存储用户发布的短内容及其公开状态。
model FleetingThought {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  created_by Int?
  updated_at DateTime?
  updated_by Int?
  content    String    @db.Text
  is_public  Boolean   @default(true)
  ip         String?   @db.VarChar(64)
  location   String?   @db.VarChar(512)
  platform   String?   @db.VarChar(255)
  browser    String?   @db.VarChar(255)
  status     Int       @default(1) // 0:已删除，1:正常状态

  @@map("fleeting_thought")
}

// 系统运行数据表：按名称保存运行过程中产生的动态 JSON 数据。
model SystemRuntimeData {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  created_by Int?
  updated_at DateTime?
  updated_by Int?
  name       String    @unique @db.VarChar(255)
  data       Json?

  @@map("system_runtime_data")
}

// 仪表盘统计表：按时间保存站点访问和业务统计快照。
model Dashboard {
  id         Int       @id @default(autoincrement())
  created_at DateTime? @default(now())
  updated_at DateTime?
  time       DateTime  @unique
  data       Json

  @@map("dashboard")
}

// 导航网站表：管理网站与书签的链接、标签和展示状态。
model NavigationWebsite {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  name        String    @db.VarChar(255)
  url         String    @db.VarChar(512)
  icon        String?   @db.VarChar(512)
  tags        Json?
  description String?   @db.VarChar(1024)
  type        Int       @default(1) // 1: 网站 2: 书签
  hot         Int       @default(0)
  is_favorite Boolean   @default(false)
  is_public   Boolean   @default(true)
  status      Int       @default(1) // 0:已删除，1:正常状态，2:禁用状态

  @@map("navigation_website")
}

// 导航搜索引擎表：管理可用搜索引擎及其查询地址。
model NavigationSearchEngine {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(1024)
  url         String    @db.VarChar(512)
  icon        String    @db.VarChar(512)
  is_public   Boolean   @default(true)
  status      Int       @default(1) // 0:已删除，1:正常状态，2:禁用状态

  histories NavigationSearchHistory[]

  @@map("navigation_search_engine")
}

// 导航搜索历史表：记录用户使用搜索引擎提交的关键词。
model NavigationSearchHistory {
  id               Int       @id @default(autoincrement())
  created_at       DateTime? @default(now())
  created_by       Int?
  search_engine_id Int
  keyword          String    @db.VarChar(512)
  ip               String?   @db.VarChar(64)

  NavigationSearchEngine NavigationSearchEngine @relation(fields: [search_engine_id], references: [id])

  @@index([created_by, id])
  @@index([search_engine_id, id])
  @@map("navigation_search_history")
}

// 导航快捷方式表：管理导航页快捷入口及公开状态。
model NavigationShortcut {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  name        String    @db.VarChar(255)
  description String?   @db.VarChar(1024)
  url         String    @db.VarChar(512)
  icon        String    @db.VarChar(512)
  is_public   Boolean   @default(true)
  status      Int       @default(1) // 0:已删除，1:正常状态，2:禁用状态

  @@map("navigation_shortcut")
}

// 画布文档表：统一存储看板、白板、流程图和思维导图等数据。
model CanvasDocument {
  id          Int       @id @default(autoincrement())
  created_at  DateTime? @default(now())
  created_by  Int?
  updated_at  DateTime?
  updated_by  Int?
  type        String    @db.VarChar(32) // 板块类型：kanban | whiteboard | flowchart | mindmap 等，由前端组件按类型自治 data 结构
  title       String    @db.VarChar(255)
  description String?   @db.VarChar(1024)
  data        Json // 核心业务数据，结构由前端组件按 type 自行定义
  cover       String?   @db.VarChar(512) // 封面缩略图，便于列表展示
  status      Int       @default(1) // 0:已删除，1:正常状态，2:锁定状态

  @@index([type, status])
  @@index([status, created_at])
  @@map("canvas_document")
}

// 日程事件表：存储普通及周期日程，并支持 iCalendar 导入导出。
model CalendarEvent {
  id               Int       @id @default(autoincrement())
  created_at       DateTime? @default(now())
  created_by       Int?
  updated_at       DateTime?
  updated_by       Int?
  uid              String    @unique @default(uuid()) @db.Uuid // iCalendar UID，用于跨系统唯一识别事件
  title            String    @db.VarChar(255)
  description      String?   @db.Text
  location         String?   @db.VarChar(512)
  color            String?   @db.VarChar(32)
  start_at         DateTime  @db.Timestamptz(3) // 首次发生时间，统一按 UTC 保存
  end_at           DateTime  @db.Timestamptz(3) // 首次结束时间，统一按 UTC 保存
  all_day          Boolean   @default(false)
  timezone         String    @default("Asia/Shanghai") @db.VarChar(64) // 事件原始时区
  recurrence_rule  String?   @db.Text // 标准 iCalendar RRULE，普通事件为空
  recurrence_until DateTime? @db.Timestamptz(3) // 周期截止时间；无限周期或按次数结束时为空
  status           Int       @default(1) // 0:已删除，1:正常状态

  @@index([created_by, status])
  @@index([created_by, start_at, end_at])
  @@index([created_by, recurrence_until])
  @@index([status, start_at])
  @@map("calendar_event")
}

// 日期拓展属性表：按公历日期存储农历、干支、黄历和节气等只读属性。
model DateAttribute {
  id    Int  @id @default(autoincrement())
  year  Int // 公历年份
  month Int // 公历月份，1-12
  day   Int // 公历日期，1-31
  extra Json @default("{}") // 农历、干支、黄历、节气等可扩展日期属性

  @@unique([year, month, day], map: "date_attributes_year_month_day_key")
  @@map("date_attributes")
}
